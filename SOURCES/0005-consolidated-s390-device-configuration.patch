-        super().online_device()
+        self._set_zfcp_device_online()
 
         if not has_auto_lun_scan(self.devnum):
             raise ValueError(_("zFCP device %s cannot use auto LUN scan.") % self)
@@ -480,13 +425,7 @@ class zFCP:
                 log.warning("%s", str(e))
 
     def write(self, root):
-        if len(self.fcpdevs) == 0:
-            return
