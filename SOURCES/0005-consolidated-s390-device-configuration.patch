-                devonline = f.readline().strip()
-            if devonline != "1":
-                logged_write_line_to_file(self._device_online_path, "1")
+            util.run_program(["chzdev", "--enable", "zfcp-host", self.devnum,
+                              "--yes", "--no-root-update", "--force"])
